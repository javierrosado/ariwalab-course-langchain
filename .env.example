# ============================================================================
# Curso IA Agent Building — copia este archivo como .env y complétalo
# El .env NUNCA se sube al repositorio (ver .gitignore)
# ============================================================================

# ---------- Proveedor activo ----------
# huggingface : sesiones 1 a 11 (todo el curso)
# foundry     : solo el bonus de Foundry
AI_PROVIDER=huggingface

# ---------- Hugging Face ----------
# Token en https://huggingface.co/settings/tokens (permiso de inferencia)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_BASE_URL=https://router.huggingface.co/v1
HF_EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Un solo modelo para las 4 industrias (decisión D21 · camino A).
# La personalización vive en comun/prompts_industria.py y en la colección de Qdrant.
# Qwen3-32B: denso, Apache 2.0, tool calling nativo, 100+ idiomas.
# Verificado el 2026-09-10 con `check_stack --candidatos`: fue el ÚNICO de 4
# candidatos que pasó las comprobaciones críticas (decisión D28).
HF_CHAT_MODEL=Qwen/Qwen3-32B
HF_ENABLE_THINKING=false

# ---------- Simulador de industria (decisión D22) ----------
# csv : datasets locales           → Laboratorios 1 y 2
# api : simulador de industria     → Laboratorio 3 en adelante
DATA_SOURCE=csv
SIM_BASE_URL=http://localhost:8000
SIM_API_KEY=demo-key-0000
SIM_TIMEOUT=10

# Servidor MCP del simulador (Laboratorio 4)
MCP_TRANSPORT=stdio
MCP_HTTP_URL=http://localhost:8000/mcp
MCP_STDIO_ARGS=simulador-industria/mcp_server.py

# ---------- Qdrant Cloud ----------
# Cluster gratuito en https://cloud.qdrant.io
QDRANT_URL=https://xxxxxxxx.us-east.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
QDRANT_COLLECTION=kb-telecomunicaciones

# ---------- Langfuse Cloud ----------
# Proyecto gratuito en https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com

# ---------- Track de industria ----------
# telecomunicaciones | banca | retail | seguros
COURSE_TRACK=telecomunicaciones

# ============================================================================
# SOLO bonus de Foundry — descomentar y poner AI_PROVIDER=foundry
# ============================================================================
# AI_ENDPOINT=https://<recurso>.services.ai.azure.com/openai/v1
# AI_API_KEY=<clave>
# AI_MODEL=gpt-5-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small
# AZURE_SUBSCRIPTION_ID=<subscription-id>
# FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<proyecto>
# AZURE_LOCATION=<region>
